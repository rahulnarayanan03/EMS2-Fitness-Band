CONSTANTS:
  THRESHOLD       = 0.4g       // peak height above baseline to count
  HYSTERESIS      = 0.16g      // THRESHOLD × 0.4 — must fall below this to confirm peak
  COOLDOWN        = 250ms      // fastest physically possible step
 
STATE:
  stepCount       = 0
  aboveThreshold  = false
  lastStepTime    = 0
 
─────────────────────────────────────────────
SETUP:
  init I2C
  init ADXL345 at ±2g, 50Hz
  load stepCount from NVS flash
 
─────────────────────────────────────────────
LOOP (runs every 20ms → 50Hz):
 
  1. READ raw X, Y, Z from ADXL345
 
  2. COMPUTE magnitude = √(X² + Y² + Z²)
     // orientation-independent — works no matter how device is mounted
 
  3. PEAK DETECTION (hysteresis gate):
 
     IF aboveThreshold = false AND magnitude > (1g + THRESHOLD):
       aboveThreshold ← true          // rising edge — start watching for peak
       (do NOT count yet)
 
     ELSE IF aboveThreshold = true AND magnitude < (1g + HYSTERESIS):
       aboveThreshold ← false         // falling edge — peak is complete
 
       4. TIMING GATE (cooldown filter):
          IF (now − lastStepTime) >= COOLDOWN:
            lastStepTime ← now
            stepCount ← stepCount + 1  // ✓ valid step
 
            IF stepCount mod 10 = 0:
              SAVE stepCount to NVS    // batch writes to limit flash wear
 
  5. UPDATE display every 300ms
  6. PRINT debug to serial every 500ms